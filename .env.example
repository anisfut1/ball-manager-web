# Copier ce fichier en .env.local (jamais commité) et renseigner les vraies
# valeurs du projet Supabase. Voir README.md pour la procédure complète.

# --- Publiques (exposées au navigateur, préfixe NEXT_PUBLIC_ obligatoire) ---
# URL du projet Supabase (Project Settings > API). Utilisée UNIQUEMENT pour
# l'authentification/session (voir docs/ARCHITECTURE.md) — plus aucune
# donnée métier n'est lue directement depuis Supabase par ce frontend.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé anonyme du projet (Project Settings > API). Soumise à la RLS, sans danger
# à exposer côté client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL du backend ball-manager-back (https://github.com/anisfut1/ball-manager-back).
# Toutes les données métier (clubs, matchs, intégrations, stats...) passent
# par cette API — voir src/lib/api/. En développement, le backend tourne en
# local sur http://localhost:3001 (`npm run dev` dans ball-manager-back).
NEXT_PUBLIC_CLUB_MANAGER_API_URL=https://api.example.com

# Aucun secret serveur (service role Supabase, CRON_SECRET, clé de
# chiffrement FBI...) n'existe dans ce projet — ces valeurs vivent
# exclusivement dans ball-manager-back (voir docs/MIGRATION_TO_API.md).

# --- Feature flags de migration (SERVEUR uniquement, jamais NEXT_PUBLIC_) ---
# LOT-06 : "1" = les filtres de la liste des matchs (équipe, domicile/extérieur,
# période « À venir »/« Passés ») sont appliqués par l'API. Absent ou autre
# valeur = comportement historique (saison entière filtrée localement).
# FF_MATCHES_SERVER_FILTERS=1

# --- Session persistante de l'espace public (cookie HttpOnly, docs/PWA_SESSION.md) ---
# Secret SERVEUR (≥ 32 caractères, ex. `openssl rand -base64 48`) qui chiffre le cookie
# de session. Absent → la session persistante est désactivée et le front retombe sur
# son comportement d'avant (localStorage). Le changer déconnecte tout le monde.
SESSION_SECRET=
# Révocation globale : incrémenter (« 2 », « 3 »…) invalide toutes les sessions existantes.
SESSION_EPOCH=1

# --- Web Push (préparé, INACTIF — docs/PWA_PUSH.md) ---
# NEXT_PUBLIC_PUSH_ENABLED=1
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Adresse de contact affichée sur /confidentialite et /support (boîte réellement
# lue). Absente : les pages renvoient vers le club. Exigée par l'App Store
# (URL d'assistance), voir docs/MOBILE_WEB_SUPPORT.md.
# NEXT_PUBLIC_SUPPORT_EMAIL=

# Identifiant App Store de l'app iOS (chiffres, visible dans App Store Connect).
# Présent : bannière Smart App Banner sur l'espace public, et bouton
# « Installer » (PWA) masqué sur iPhone. Absent : rien ne change.
# NEXT_PUBLIC_APP_STORE_ID=
# Optionnel, défaut YFZ72KY47V (AASA / Universal Links).
# APPLE_TEAM_ID=
