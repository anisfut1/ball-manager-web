{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@/lib/api/client": ["./src/shims/api-client.ts"],
      "@/server/actions/auth": ["./src/shims/server-actions-auth.ts"],
      "@/config/env.public": ["./src/shims/env-public.ts"],
      "@/*": ["../src/*"],
      "next/link": ["./src/shims/next-link.tsx"],
      "next/image": ["./src/shims/next-image.tsx"],
      "next/navigation": ["./src/shims/next-navigation.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "lucide-react": ["./node_modules/lucide-react"],
      "remotion": ["./node_modules/remotion"],
      "zod": ["./node_modules/zod"],
      "@supabase/ssr": ["./node_modules/@supabase/ssr"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "remotion.config.ts"]
}
