{
  "name": "ball-manager-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "tsx scripts/generate-api-types.ts",
    "api:smoke": "tsx scripts/api-smoke.ts",
    "fbi:setup": "npm --prefix spikes/fbi-auth install",
    "fbi:probe": "npm --prefix spikes/fbi-auth run probe --",
    "fbi:check-session": "npm --prefix spikes/fbi-auth run check-session",
    "fbi:report": "npm --prefix spikes/fbi-auth run report",
    "fbi:clean": "npm --prefix spikes/fbi-auth run clean",
    "fbi:inspect-export": "npm --prefix spikes/fbi-auth run inspect-export --"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.48.0",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
